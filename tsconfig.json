{
  "$schema": "http://json.schemastore.org/tsconfig",
  "extends": "../typescript/tsconfig.json",
  // at: /projects/monorepo-one/services/rpc-worker-pool/tsconfig.json
  "compilerOptions": {
    /* Emit Options */
    "target": "ES2020",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "./src",
    "outDir": "dist",
    "declarationDir": "dist/typings",
    "tsBuildInfoFile": "./dist/ts-out-info.lib",
    "declaration": true,
    "declarationMap": true,
    "inlineSources": true,
    "inlineSourceMap": false,
    "sourceMap": true,
    // "sourceMap": false, // opted out in favor of inlineSourceMap
    "emitDeclarationOnly": false,
    "emitDecoratorMetadata": false,
    "experimentalDecorators": false,
    /* JavaScript Support */
    "allowJs": true,
    "checkJs": false,
    /* Bundled library declaration files that describe the target runtime environment. */
    "lib": [
      "dom",
      "esnext"
    ],
    /* Module Resolution */
    "resolveJsonModule": true,
    "typeRoots": [
      "./node_modules/@types",
      "./global"
    ],
    /* Package names to be included without being referenced in a source file. */
    "types": [
      "node",
      "global"
    ],
    "baseUrl": ".",
    "paths": {
      "src/*": [
        "src/*"
      ]
    },
    "esModuleInterop": true,
    "strict": true
  },
  "include": [
    "src/**/*",
    "global/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
